# рабочие файлы, которые не должны уезжать на сайт
ИДЕИ.txt
_*.html

# приватные исходники дилерских кодов (Volvo/Mercedes/Scania) — не для паблика
pcode-source/

# локальный кэш wrangler (Cloudflare Worker deploy tooling).
# Вторая строка - когда wrangler запускают из корня репозитория,
# например для заливки KV (см. scripts/kv_plan.py).
worker/.wrangler/
.wrangler/

# Байт-код Python: пересобирается сам при каждом запуске scripts/*.py
# и оттого вечно висел в git status, засоряя вывод перед коммитом.
__pycache__/
*.pyc
